@using DemoMVC.Models.ViewModels
@model IEnumerable<UserWithRolesViewModel>

@{
    ViewData["Title"] = "Gán Role cho người dùng";
}

<h2>Gán Role cho người dùng</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<table class="table table-bordered table-striped align-middle">
    <thead>
        <tr>
            <th>Tài khoản (UserName)</th>
            <th>Email</th>
            <th>Role hiện tại</th>
            <th style="width: 240px;">Thao tác</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var user in Model)
        {
            <tr>
                <td>@user.UserName</td>
                <td>@user.Email</td>
                <td>
                    @if (user.Roles.Any())
                    {
                        foreach (var role in user.Roles)
                        {
                            <span class="badge bg-primary me-1">@role</span>
                        }
                    }
                    else
                    {
                        <span class="text-muted">Chưa có Role</span>
                    }
                </td>
                <td>
                    <a asp-action="Manage" asp-route-userId="@user.UserId" class="btn btn-sm btn-warning">
                        Phân Role
                    </a>
                    <a asp-action="EditProfile" asp-route-id="@user.UserId" class="btn btn-sm btn-info text-white">
                        Sửa
                    </a>
                    <form asp-action="DeleteUser" asp-route-id="@user.UserId" method="post" class="d-inline"
                          onsubmit="return confirm('Bạn có chắc muốn xóa tài khoản @user.Email?');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-sm btn-danger">Xóa</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>