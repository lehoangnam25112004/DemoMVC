@model DemoMVC.Models.StudentIndexViewModel

@{
    var isAdmin = User.IsInRole("Admin");
}

@if (Model.Items.Any())
{
    <div class="text-muted mb-3">
        Hiển thị @Model.Items.Count() / @Model.TotalItems bản ghi · Trang @Model.PageNumber / @Model.TotalPages
    </div>

    <div class="table-responsive">
        <table class="table table-striped table-bordered align-middle mb-0">
            <thead>
                <tr>
                    <th>Mã sinh viên</th>
                    <th>Họ và tên</th>
                    <th>Địa chỉ</th>
                    <th>Email</th>
                    <th>Năm nhập học</th>
                    <th>Mã hệ đào tạo</th>
                    <th>Mã ngành</th>
                    <th>Ngành</th>
                    @if (isAdmin)
                    {
                        <th style="width: 170px;">Thao tác</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.Items)
                {
                    <tr data-id="@item.StudentId"
                        data-fullname="@item.FullName"
                        data-address="@item.Address"
                        data-email="@item.Email"
                        data-admissionyear="@item.AdmissionYear"
                        data-trainingsystemcode="@item.TrainingSystemCode"
                        data-majorid="@item.MajorId"
                        data-majorcode="@item.MajorCode">
                        <td>@item.StudentCode</td>
                        <td>@item.FullName</td>
                        <td>@item.Address</td>
                        <td>@item.Email</td>
                        <td>@item.AdmissionYear</td>
                        <td>@item.TrainingSystemCode</td>
                        <td>@item.MajorCode</td>
                        <td>@(item.Major != null ? item.Major.MajorName : "")</td>
                        @if (isAdmin)
                        {
                            <td>
                                <button type="button" class="btn btn-sm btn-warning btn-edit" data-id="@item.StudentId">Sửa</button>
                                <button type="button" class="btn btn-sm btn-danger btn-delete" data-id="@item.StudentId">Xóa</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <nav aria-label="Student pagination" class="mt-3">
        <ul class="pagination justify-content-center mb-0">
            <li class="page-item @(Model.PageNumber <= 1 ? "disabled" : "")">
                <a class="page-link" href="#" data-page="@(Model.PageNumber - 1)">Previous</a>
            </li>

            @for (var i = 1; i <= Model.TotalPages; i++)
            {
                <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                    <a class="page-link" href="#" data-page="@i">@i</a>
                </li>
            }

            <li class="page-item @(Model.PageNumber >= Model.TotalPages ? "disabled" : "")">
                <a class="page-link" href="#" data-page="@(Model.PageNumber + 1)">Next</a>
            </li>
        </ul>
    </nav>
}
else
{
    <div class="alert alert-info mb-0">Không có dữ liệu phù hợp.</div>
}