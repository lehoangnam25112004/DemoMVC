@model DemoMVC.Models.Student

<h2>Thông tin sinh viên</h2>

<form asp-controller="Student" asp-action="Create" method="post">

    <p>
        Họ và tên: <input asp-for="FullName" />
    </p>

    <p>
        Địa chỉ: <input asp-for="Address" />
    </p>

    <p>
        Trường đại học: <input asp-for="University" />
    </p>

    <button type="submit">Gửi</button>
</form>

<hr />

<h3>Kết quả</h3>

<p>@ViewBag.Message</p> 
<p>@Model.FullName  @Model.Address  @Model.University</p>
