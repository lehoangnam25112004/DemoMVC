@model DemoMVC.Models.StudentIndexViewModel

@{
    ViewData["Title"] = "Danh sách sinh viên";
    var isAdmin = User.IsInRole("Admin");
}

<h1>Danh sách sinh viên</h1>

<div class="row g-4 mb-4">
    @if (isAdmin)
    {
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <strong id="studentFormTitle">Thêm sinh viên</strong>
                </div>
                <div class="card-body">
                    <form id="studentForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" id="studentId" name="StudentId" value="" />

                        <div class="mb-3">
                            <label class="form-label">Họ và tên</label>
                            <input type="text" name="FullName" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Địa chỉ</label>
                            <input type="text" name="Address" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Email</label>
                            <input type="email" name="Email" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Năm nhập học</label>
                            <input type="number" name="AdmissionYear" min="2000" max="2099" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Mã hệ đào tạo</label>
                            <input type="text" name="TrainingSystemCode" maxlength="2" class="form-control" required />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Ngành</label>
                            <select name="MajorId" class="form-select" required>
                                <option value="">-- Chọn ngành --</option>
                                @foreach (var item in (IEnumerable<SelectListItem>)ViewData["MajorId"]!)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary" id="saveStudentBtn">Lưu</button>
                            <button type="button" class="btn btn-secondary d-none" id="cancelEditBtn">Hủy</button>
                        </div>
                        <div id="studentFormError" class="text-danger mt-2"></div>
                    </form>
                </div>
            </div>
        </div>
    }

    <div class="@(isAdmin ? "col-lg-8" : "col-12")">
        <div class="card shadow-sm">
            <div class="card-body">
                <form id="searchForm" class="row g-3 align-items-end mb-3">
                    <div class="col-md-5">
                        <label class="form-label">Tìm kiếm</label>
                        <input type="text" name="searchTerm" value="@Model.SearchTerm" class="form-control" placeholder="Mã SV, tên, email, ngành, địa chỉ" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Sắp xếp</label>
                        <select name="sortBy" class="form-select">
                            <option value="StudentCode" selected="@(Model.SortBy == "StudentCode" ? "selected" : null)">Mã sinh viên</option>
                            <option value="FullName" selected="@(Model.SortBy == "FullName" ? "selected" : null)">Họ tên</option>
                            <option value="AdmissionYear" selected="@(Model.SortBy == "AdmissionYear" ? "selected" : null)">Năm nhập học</option>
                            <option value="MajorName" selected="@(Model.SortBy == "MajorName" ? "selected" : null)">Ngành</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Thứ tự</label>
                        <select name="sortDirection" class="form-select">
                            <option value="asc" selected="@(Model.SortDirection == "asc" ? "selected" : null)">Tăng dần</option>
                            <option value="desc" selected="@(Model.SortDirection == "desc" ? "selected" : null)">Giảm dần</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Hiển thị</label>
                        <select name="pageSize" class="form-select">
                            <option value="10" selected="@(Model.PageSize == 10 ? "selected" : null)">10</option>
                            <option value="20" selected="@(Model.PageSize == 20 ? "selected" : null)">20</option>
                            <option value="50" selected="@(Model.PageSize == 50 ? "selected" : null)">50</option>
                        </select>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-outline-primary">Áp dụng</button>
                        <button type="button" class="btn btn-outline-secondary" id="resetSearchBtn">Reset</button>
                    </div>
                </form>

                <div id="studentTableContainer">
                    @await Html.PartialAsync("_StudentTable", Model)
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const isAdmin = @Json.Serialize(isAdmin);
        const studentTableUrl = '@Url.Action("ListPartial", "Student")';
        const createStudentUrl = '@Url.Action("CreateAjax", "Student")';
        const editStudentUrl = '@Url.Action("EditAjax", "Student")';
        const deleteStudentUrl = '@Url.Action("DeleteAjax", "Student")';

        function refreshTable() {
            const searchData = $('#searchForm').serialize();
            $.ajax({
                url: studentTableUrl,
                type: 'GET',
                data: searchData,
                success: function (html) {
                    $('#studentTableContainer').html(html);
                },
                error: function () {
                    $('#studentTableContainer').html('<div class="alert alert-danger">Không thể tải dữ liệu.</div>');
                }
            });
        }

        $('#searchForm').on('submit', function (e) {
            e.preventDefault();
            refreshTable();
        });

        $('#resetSearchBtn').on('click', function () {
            $('#searchForm')[0].reset();
            refreshTable();
        });

        $(document).on('click', '.page-link', function (e) {
            e.preventDefault();
            const page = $(this).data('page');
            if (!page || $(this).parent().hasClass('disabled')) {
                return;
            }

            const data = $('#searchForm').serialize() + '&pageNumber=' + page;
            $.ajax({
                url: studentTableUrl,
                type: 'GET',
                data: data,
                success: function (html) {
                    $('#studentTableContainer').html(html);
                }
            });
        });

        if (isAdmin) {
            function clearStudentForm() {
                $('#studentForm')[0].reset();
                $('#studentId').val('');
                $('#studentFormTitle').text('Thêm sinh viên');
                $('#saveStudentBtn').text('Lưu');
                $('#cancelEditBtn').addClass('d-none');
                $('#studentFormError').text('');
            }

            $('#cancelEditBtn').on('click', function () {
                clearStudentForm();
            });

            $('#studentForm').on('submit', function (e) {
                e.preventDefault();
                const id = $('#studentId').val();
                const formData = $(this).serialize();
                const url = id ? editStudentUrl + '?id=' + id : createStudentUrl;

                $.ajax({
                    url: url,
                    type: 'POST',
                    data: formData,
                    success: function (response) {
                        if (response.success) {
                            clearStudentForm();
                            refreshTable();
                            alert(response.message);
                        } else {
                            $('#studentFormError').text(response.message || 'Có lỗi xảy ra.');
                        }
                    },
                    error: function (xhr) {
                        let message = 'Có lỗi xảy ra khi lưu dữ liệu.';
                        if (!id && xhr.responseJSON && xhr.responseJSON.errors && xhr.responseJSON.errors.length) {
                            message = xhr.responseJSON.errors.join('\n');
                        } else if (xhr.responseJSON && xhr.responseJSON.message) {
                            message = xhr.responseJSON.message;
                        }
                        $('#studentFormError').text(message);
                    }
                });
            });

            $(document).on('click', '.btn-edit', function () {
                const row = $(this).closest('tr');
                $('#studentId').val(row.data('id'));
                $('input[name="FullName"]').val(row.data('fullname'));
                $('input[name="Address"]').val(row.data('address'));
                $('input[name="Email"]').val(row.data('email'));
                $('input[name="AdmissionYear"]').val(row.data('admissionyear'));
                $('input[name="TrainingSystemCode"]').val(row.data('trainingsystemcode'));
                $('select[name="MajorId"]').val(row.data('majorid'));
                $('#studentFormTitle').text('Sửa sinh viên');
                $('#saveStudentBtn').text('Cập nhật');
                $('#cancelEditBtn').removeClass('d-none');
                $('#studentFormError').text('');
            });

            $(document).on('click', '.btn-delete', function () {
                const id = $(this).data('id');
                if (!confirm('Bạn có chắc muốn xóa sinh viên này?')) {
                    return;
                }

                $.ajax({
                    url: deleteStudentUrl,
                    type: 'POST',
                    data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                    success: function (response) {
                        if (response.success) {
                            refreshTable();
                            alert(response.message);
                        }
                    },
                    error: function (xhr) {
                        alert(xhr.responseJSON && xhr.responseJSON.message ? xhr.responseJSON.message : 'Xóa sinh viên thất bại.');
                    }
                });
            });
        }
    </script>
}