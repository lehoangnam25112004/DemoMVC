@using Microsoft.AspNetCore.Identity
@using DemoMVC.Models.ViewModels
@model RolePermissionMatrixViewModel

@{
    ViewData["Title"] = "Phân quyền động theo Role";
    var roles = ViewBag.Roles as List<IdentityRole> ?? new List<IdentityRole>();
    int flatIndex = 0;
}

<h2>Phân quyền động theo Role</h2>

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">@TempData["Success"]</div>
}
@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

@if (roles.Any())
{
    <form method="get" asp-action="Index" class="row g-2 mb-3">
        <div class="col-auto">
            <label class="col-form-label fw-bold">Chọn Role:</label>
        </div>
        <div class="col-auto">
            <select name="roleId" class="form-select" onchange="this.form.submit()">
                @foreach (var r in roles)
                {
                    <option value="@r.Id" selected="@(r.Id == Model.RoleId)">@r.Name</option>
                }
            </select>
        </div>
    </form>

    <form asp-action="Save" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="RoleId" />
        <input type="hidden" asp-for="RoleName" />

        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
            <span class="text-muted">Đang cấu hình quyền cho Role: <strong>@Model.RoleName</strong></span>
            <button type="submit" class="btn btn-primary">Lưu phân quyền</button>
        </div>

        @for (int c = 0; c < Model.Controllers.Count; c++)
        {
            <div class="card mb-3">
                <div class="card-header fw-bold bg-light">
                    Controller: @Model.Controllers[c].ControllerName
                    <input type="hidden" asp-for="Controllers[c].ControllerName" />
                </div>
                <div class="card-body">
                    <div class="row">
                        @for (int a = 0; a < Model.Controllers[c].Actions.Count; a++)
                        {
                            var idAttr = $"perm_{flatIndex++}";
                            <div class="col-md-3 col-sm-6 mb-2">
                                <div class="form-check">
                                    <input type="hidden" asp-for="Controllers[c].Actions[a].ControllerName" />
                                    <input type="hidden" asp-for="Controllers[c].Actions[a].ActionName" />
                                    <input class="form-check-input" asp-for="Controllers[c].Actions[a].IsAllowed" id="@idAttr" />
                                    <label class="form-check-label" for="@idAttr">
                                        @Model.Controllers[c].Actions[a].ActionName
                                    </label>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </form>
}